@page
@model FichApp.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<section class="dashboard narrow-dashboard">
    <p class="eyebrow">ACCESO SEGURO</p>
    <h1>Iniciar sesión</h1>
    <p class="muted">Accede con la cuenta que te ha facilitado la empresa.</p>

    @if (Model.ErrorMessage is not null)
    {
        <div class="notice notice-error mt-4" role="alert">@Model.ErrorMessage</div>
    }

    <form method="post" class="form-card mt-4">
        <input type="hidden" asp-for="ReturnUrl" />
        <label asp-for="Input.Email">Correo electrónico</label>
        <input asp-for="Input.Email" type="email" autocomplete="username" required autofocus />
        <span asp-validation-for="Input.Email" class="field-error"></span>

        <label asp-for="Input.Password">Contraseña</label>
        <input asp-for="Input.Password" autocomplete="current-password" required />
        <span asp-validation-for="Input.Password" class="field-error"></span>

        <label class="remember-row">
            <input asp-for="Input.RememberMe" />
            <span>Mantener la sesión iniciada</span>
        </label>

        <button type="submit" class="button button-primary">Entrar</button>
        <p class="privacy-note">Si necesitas restablecer tu contraseña, contacta con administración.</p>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
