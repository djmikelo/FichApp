@page
@model FichApp.Pages.ChangePasswordModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<section class="dashboard narrow-dashboard">
    <div class="page-heading">
        <div>
            <p class="eyebrow">SEGURIDAD DE LA CUENTA</p>
            <h1>Cambia tu contraseña</h1>
            <p class="muted">Usa una contraseña personal que no compartas con otras personas.</p>
        </div>
    </div>

    @if (Model.Errors.Count > 0)
    {
        <div class="notice notice-error" role="alert">
            <ul class="mb-0">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <form method="post" class="form-card">
        <label asp-for="Input.CurrentPassword">Contraseña actual</label>
        <input asp-for="Input.CurrentPassword" autocomplete="current-password" required />
        <label asp-for="Input.NewPassword">Nueva contraseña</label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" required />
        <p class="privacy-note">Mínimo 12 caracteres, con mayúsculas, minúsculas, números y símbolos.</p>
        <button class="button button-primary" type="submit">Guardar contraseña</button>
    </form>
</section>
