@page
@model FichApp.Pages.Admin.EmployeesModel
@{
    ViewData["Title"] = "Empleados";
}

<section class="dashboard">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ADMINISTRACIÓN</p>
            <h1>Empleados</h1>
            <p class="muted">Crea cuentas de acceso individual. No existe registro público.</p>
        </div>
        <a class="button button-secondary" asp-page="/Admin/Report">Ver informes</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="notice notice-success" role="status">@Model.StatusMessage</div>
    }
    @if (Model.Errors.Count > 0)
    {
        <div class="notice notice-error" role="alert">
            <ul class="mb-0">
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="admin-grid">
        <form method="post" asp-page-handler="Create" class="form-card">
            <h2>Añadir empleado</h2>
            <label asp-for="NewEmployee.DisplayName">Nombre y apellidos</label>
            <input asp-for="NewEmployee.DisplayName" autocomplete="name" required maxlength="200" />
            <span asp-validation-for="NewEmployee.DisplayName" class="field-error"></span>

            <label asp-for="NewEmployee.Email">Correo electrónico</label>
            <input asp-for="NewEmployee.Email" type="email" autocomplete="email" required maxlength="256" />
            <span asp-validation-for="NewEmployee.Email" class="field-error"></span>

            <label asp-for="NewEmployee.Password">Contraseña inicial</label>
            <input asp-for="NewEmployee.Password" type="password" autocomplete="new-password" required />
            <span asp-validation-for="NewEmployee.Password" class="field-error"></span>
            <p class="privacy-note">Debe tener al menos 12 caracteres, mayúsculas, minúsculas, números y símbolos. El empleado tendrá que cambiarla al entrar.</p>

            <button class="button button-primary" type="submit">Crear cuenta</button>
        </form>

        <div class="form-card">
            <h2>Cuentas activas</h2>
            @if (Model.Employees.Count == 0)
            {
                <p class="muted">Todavía no hay empleados.</p>
            }
            else
            {
                <div class="employee-list">
                    @foreach (var employee in Model.Employees)
                    {
                        <div class="employee-row">
                            <span class="avatar">@employee.Initials</span>
                            <div>
                                <strong>@employee.DisplayName</strong>
                                <span>@employee.Email</span>
                                <details class="reset-details">
                                    <summary>Restablecer contraseña</summary>
                                    <form method="post" asp-page-handler="ResetPassword" class="reset-form">
                                        <input type="hidden" name="userId" value="@employee.UserId" />
                                        <label for="password-@employee.UserId">Contraseña temporal</label>
                                        <input id="password-@employee.UserId" name="newPassword" type="password" autocomplete="new-password" required />
                                        <button class="button button-secondary" type="submit">Restablecer</button>
                                    </form>
                                </details>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
